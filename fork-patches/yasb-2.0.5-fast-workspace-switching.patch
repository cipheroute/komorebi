@@ -425,6 +440,27 @@ class WorkspaceWidget(BaseWidget):
     def _get_focused_workspace(self):
         return self._komorebic.get_focused_workspace(self._komorebi_screen)
 
+    def _predicted_focused_hwnd(self, state: dict) -> int | None:
+        """The window komorebi focuses on the focused workspace of this screen (0 when the
+        workspace is empty), or None when this screen isn't the focused one"""
+        try:
+            if state["monitors"]["focused"] != self._komorebi_screen["index"]:
+                return None
+            workspace = self._get_focused_workspace()
+            monocle = self._komorebic.get_monocle_container(workspace)
+            if monocle:
+                return self._komorebic.get_focused_window(monocle)["hwnd"]
+            maximized = workspace.get("maximized_window")
+            if isinstance(maximized, dict):
+                return maximized["hwnd"]
+            containers = workspace["containers"]
+            if containers["elements"]:
+                container = containers["elements"][containers["focused"]]
+                return self._komorebic.get_focused_window(container)["hwnd"]
+            return 0
+        except KeyError, TypeError, IndexError:
+            return None
+
     def _has_active_workspace_index_changed(self):
         return self._prev_workspace_index != self._curr_workspace_index
 
